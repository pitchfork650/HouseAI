# ==============================================================================
# HouseAI Environment Configuration
# ==============================================================================

# Google Gemini API Key
# 1. Get your free API key at: https://aistudio.google.com/app/apikey
# 2. Paste it below and rename this file to .env (or keep .env in your project root)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-1.5-pro, gemini-2.5-pro, or gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-pro

# API Base URL (default is local FastAPI server)
CONSENSUSFLOW_API_URL=http://localhost:8000
