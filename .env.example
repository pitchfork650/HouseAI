# ==============================================================================
# HouseAI Dental: copy to .env (never commit .env). In Codespaces, set these
# as Codespaces secrets instead.
# ==============================================================================

# Postgres (Supabase) everywhere: dev, tests and production (Vercel).
# Supabase dashboard -> Connect. Use the pooler hosts: the "Direct connection" host is
# IPv6-only, and Vercel and Codespaces can't reach it.
#   DATABASE_URL: Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1 (app runtime)
#   DIRECT_URL:   Session pooler (port 5432) (prisma db push / schema changes)
# The Vercel build pushes the schema and seeds an empty database (npm run vercel-build).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Tests get their own schema and empty it before every run. Must set ?schema= (not
# public) and differ from the URLs above; the tests refuse to run otherwise.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=test"

# Uploaded files (encrypted) go to a private Supabase Storage bucket when these are
# set; otherwise ./storage on local disk. Service role key: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=patient-files

# Leave empty to run in MOCK MODE: every model call returns canned responses.
GEMINI_API_KEY=
# Free-tier keys get no Pro quota; use a Flash model unless billing is on.
GEMINI_MODEL=gemini-3.5-flash

# Data residency. "eu" + DATA_RESIDENCY_ENFORCE=true refuses model calls unless
# they go through Vertex AI in an EU region (GOOGLE_CLOUD_LOCATION=europe-west4).
DATA_RESIDENCY=eu
DATA_RESIDENCY_ENFORCE=false
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4

# 32-byte key, base64. Used for AES-256-GCM encryption of uploaded files at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=

# Clinic wall-clock "now" for the demo (leave empty to use the real clock).
DEMO_NOW=2026-10-04T10:00:00Z

# In-process follow-up scheduler (sends due emails, day-12 reminders).
# On Vercel the interval doesn't survive between requests: a daily Vercel Cron calls
# GET /api/cron/tick with this secret (vercel.json). Any long random string.
CRON_SECRET=
SCHEDULER_ENABLED=true

# ---- Legacy Python prototype (legacy/python-api/) ----
CONSENSUSFLOW_API_URL=http://localhost:8000

# ---- OpenSwarm host ----
# Swarms run on OpenSwarm on a separate host device (reached through the team's MCP server).
# "mock" (default) replays the sample runs; "openswarm" uses the host below.
SWARM_HOST=mock
# Diagnostic (X-ray) swarm only: "gemini" reads real X-rays with GEMINI_MODEL in this
# server. Free-tier keys allow ~20 requests/day per model and a read is ~7 calls.
# Try it on real bitewings: npm run xrays:import, then npm run xrays:eval.
DIAGNOSTIC_HOST=
# Must be HTTPS (e.g. a Cloudflare Tunnel hostname) or a Tailscale address (*.ts.net / 100.x).
# Never an open port on the internet.
OPENSWARM_HOST_URL=
OPENSWARM_TOKEN=

# ---- Practice (defaults: Leo C. Yang, DDS) ----
NEXT_PUBLIC_DOCTOR_NAME=Dr. Leo C. Yang
NEXT_PUBLIC_DOCTOR_SHORT=DR. YANG
NEXT_PUBLIC_DOCTOR_INITIALS=LY
NEXT_PUBLIC_PRACTICE_NAME=Leo C. Yang, DDS
NEXT_PUBLIC_PRACTICE_SPECIALTY=Cosmetic & restorative dentistry
PRACTICE_EMAIL=
PRACTICE_PHONE=

# ---- Email ----
# "Send test" on a follow-up goes here (never the clinic inbox or the patient).
TEST_EMAIL_TO=gah016@ucsd.edu
# Outgoing SMTP. Empty = emails are only logged. Gmail: create an app password, then
# smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
