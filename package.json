{
  "name": "houseai-dental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "host:dev": "tsx host/server.ts",
    "host:probe": "tsx --env-file-if-exists=.env scripts/host-probe.ts",
    "runs:inspect": "tsx --env-file-if-exists=.env scripts/inspect-runs.ts",
    "insurance:run": "tsx --env-file-if-exists=.env scripts/run-insurance.ts",
    "followup:draft": "tsx --env-file-if-exists=.env scripts/draft-followup.ts",
    "dentex:import": "tsx --env-file-if-exists=.env scripts/import-dentex.ts",
    "dentex:eval": "tsx --env-file-if-exists=.env scripts/eval-dentex.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.8",
    "nodemailer": "^7.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
