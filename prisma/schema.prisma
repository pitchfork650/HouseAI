// HouseAI Dental data model.
// SQLite in dev; kept Postgres-compatible (no SQLite-only types). To switch, set
// provider = "postgresql" and point DATABASE_URL at Postgres.
// Times of day are stored as clinic wall-clock values: `date` strings (YYYY-MM-DD)
// plus minutes from midnight for appointments, and DateTime values read in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id                     String   @id // e.g. "P-1042"
  name                   String // display name, e.g. "Jordan M."
  initials               String
  dob                    String? // literal placeholder "[DATE]" in seed
  ageYears               Int?
  email                  String?
  allergies              Json // string[]
  premedicationRequired  Boolean  @default(false)
  flags                  Json // free-form chips, e.g. ["Dual coverage"]
  insuranceNote          String? // e.g. "changed jobs 2026-09"
  synthetic              Boolean  @default(true) // only synthetic patients may reach a model outside production
  createdAt              DateTime @default(now())

  consents        Consent[]
  studies         ImagingStudy[]
  runs            SwarmRun[]
  treatmentItems  TreatmentItem[]
  appointments    Appointment[]
  policies        InsurancePolicy[]
  costEstimates   CostEstimate[]
  followUps       FollowUp[]
  imagingOrders   ImagingOrder[]
  documents       DocumentScan[]
  scheduleRequests ScheduleRequest[]
}

model Consent {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose   String // treatment | ai_analysis | marketing_email
  granted   Boolean
  recordRef String? // GDPR record reference, "[ID]" in seed
  timestamp DateTime @default(now())

  @@index([patientId, purpose])
}

model ImagingStudy {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String // pano | bitewing | pa | cbct | intraoral
  takenAt   DateTime
  fileUrl   String? // "synthetic:pano" for generated images, "storage:<key>" for encrypted uploads
  mimeType  String?
  width     Int?
  height    Int?
  runs      SwarmRun[]
}

model SwarmRun {
  id         String    @id @default(cuid())
  kind       String // diagnostic | insurance
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  studyId    String?
  study      ImagingStudy? @relation(fields: [studyId], references: [id], onDelete: SetNull)
  status     String // running | done | partial | failed
  summary    Json // run-level notes generated by the merge step
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  agents     AgentRun[]
  findings   Finding[]
  estimates  CostEstimate[]

  @@index([patientId, kind, startedAt])
}

model AgentRun {
  id            String    @id @default(cuid())
  runId         String
  run           SwarmRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  order         Int
  name          String
  scope         String // diagnostic scope or insurance lane target
  status        String // queued | running | done | flag | skip | failed | retry | verified | submitted
  badge         String // badge text, e.g. "2 found", "Retry 14:00"
  result        String    @default("")
  log           Json // { t: ISO string, text: string }[]
  output        Json?
  model         String?
  promptVersion String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
}

model Finding {
  id           String   @id @default(cuid())
  runId        String
  run          SwarmRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  order        Int
  teeth        Json // number[]
  condition    String // rule key, e.g. "periapical_lesion"
  text         String // plain-language explanation from the consensus agent
  reporter     String
  agreement    Int // reporter + Verifier + Skeptic, out of 3
  cdtCode      String
  suggested    String // e.g. "D3330 root canal, molar · 75 min (D0220 PA film first)"
  durationMin  Int
  visits       Int      @default(1)
  priority     String // P1 | P2 | P3 | P4
  prerequisite String? // e.g. "D0220"
  overlay      Json // OverlayShape[] in image coordinates
  confidence   Float?
  status       String   @default("suggested") // suggested | accepted | rejected
  treatment    TreatmentItem[]
}

model TreatmentItem {
  id                String   @id @default(cuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  findingId         String?
  finding           Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  cdtCode           String
  title             String
  teeth             Json
  durationMin       Int
  visits            Int      @default(1)
  priority          String
  prerequisite      String?
  requiresInsurance Boolean  @default(true)
  status            String   @default("planned") // planned | scheduled | done
  createdAt         DateTime @default(now())
  appointments      Appointment[]
}

model Provider {
  id        String   @id
  name      String
  initials  String
  chair     String // e.g. "Chair 1 · cosmetic"
  skills    Json // string[]
  order     Int
  workStart Int      @default(480) // minutes from midnight
  workEnd   Int      @default(1020)
  appointments Appointment[]
}

model Appointment {
  id              String   @id @default(cuid())
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patientId       String?
  patient         Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentItemId String?
  treatmentItem   TreatmentItem? @relation(fields: [treatmentItemId], references: [id], onDelete: SetNull)
  date            String // YYYY-MM-DD
  startMin        Int
  endMin          Int
  title           String
  meta            String   @default("")
  priority        String // P1..P4
  cdtCode         String?
  isHold          Boolean  @default(false)
  source          String   @default("manual") // manual | import | autofill | swarm

  @@index([date, providerId])
}

model ScheduleRequest {
  id            String   @id @default(cuid())
  batch         String // import batch id
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String
  procedureCode String
  procedure     String // display label, e.g. "8-unit veneer prep"
  durationMin   Int
  priority      String
  earliest      Int? // minutes from midnight
  latest        Int?
  status        String   @default("pending") // pending | placed | blocked
  blocker       String?
  appointmentId String?
  createdAt     DateTime @default(now())
}

model InsurancePolicy {
  id          String  @id @default(cuid())
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  carrier     String
  planName    String
  memberId    String
  groupNumber String
  rank        String // primary | secondary
  status      String  @default("unverified") // unverified | verified | pending | changed
  secondaryShareOfRemainder Float? // plan's nominal share of the remaining balance (used while unverified)
}

model CostEstimate {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  runId         String?
  run           SwarmRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  procedureCode String
  label         String // e.g. "IMPLANT #19"
  fee           Float? // null while the fee is a placeholder
  primaryShare  Float
  secondaryShare Float
  patientShare  Float
  primaryStatus String
  secondaryStatus String
  createdAt     DateTime @default(now())
}

model ImagingOrder {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code      String // D0220
  type      String // pa | cbct
  teeth     Json
  status    String   @default("ordered")
  createdAt DateTime @default(now())
}

model DocumentScan {
  id        String   @id @default(cuid())
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // insurance_card | record
  fileUrl   String?
  fields    Json // { [field]: { value, confidence, confirmed } }
  status    String   @default("needs_review") // needs_review | confirmed
  scannedAt DateTime @default(now())
}

model FollowUp {
  id           String   @id
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure    String // matches Video.procedure
  visitDate    String // YYYY-MM-DD
  scheduledFor DateTime
  subject      String
  content      Json // structured email content, rendered by the preview and the email HTML
  html         String
  videoId      String?
  video        Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  status       String   @default("draft") // draft | approved | sent | skipped_no_consent
  model        String?
  booked       Boolean  @default(false)
  sentAt       DateTime?
  reminderAt   DateTime?
  reminderSentAt DateTime?
}

model Video {
  id        String @id
  procedure String @unique
  title     String
  lengthSec Int
  url       String
  order     Int
  followUps FollowUp[]
}

model AuditEvent {
  id          String   @id @default(cuid())
  actor       String // "user:<id>" or agent name
  action      String
  entity      String?
  entityId    String?
  inputsHash  String?
  outputsHash String?
  model       String?
  details     Json?
  timestamp   DateTime @default(now())

  @@index([entity, entityId])
}
